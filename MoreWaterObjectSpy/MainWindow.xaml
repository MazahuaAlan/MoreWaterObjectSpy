<ui:FluentWindow x:Class="MoreWaterObjectSpy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="MoreWater Object Spy" Height="720" Width="1120" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
        Topmost="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Barra de titulo Fluent -->
    <ui:TitleBar Grid.Row="0" Title="MoreWater Object Spy v0.5.1">
      <ui:TitleBar.Icon>
        <ui:SymbolIcon Symbol="Search24"/>
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Cuerpo -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="244"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== Sidebar ===== -->
      <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}"
              CornerRadius="0" Margin="0">
        <DockPanel LastChildFill="True">

          <!-- Marca -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,14,12,10">
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentBlue}">
              <ui:SymbolIcon Symbol="Search24" FontSize="20" Foreground="White"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="MoreWater" FontWeight="Bold" FontSize="14"/>
              <TextBlock Text="Object Spy" FontWeight="SemiBold" FontSize="13" Margin="0,-2,0,0"/>
              <TextBlock Text="by MazahuaAlan" FontSize="10"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>

          <!-- Boton Guardar / Exportar JSON (como la version anterior) -->
          <ui:Button DockPanel.Dock="Bottom" Margin="14,0,14,10" HorizontalAlignment="Stretch"
                     Click="Export_Click" ToolTip="Exportar historial a JSON">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Save24" FontSize="16"/>
              <TextBlock Text="Exportar JSON" Margin="8,0,0,0"/>
            </StackPanel>
          </ui:Button>

          <!-- Estado (abajo) -->
          <Border DockPanel.Dock="Bottom" Margin="14,8,14,14" Padding="12,10"
                  CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                <TextBlock Text="Estado" Margin="8,0,0,0" FontWeight="SemiBold" FontSize="12"/>
              </StackPanel>
              <TextBlock x:Name="LblEstadoMini" Text="Detenido" Margin="0,2,0,0" FontSize="11"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
              <ui:ToggleSwitch x:Name="ThemeSwitch" Content="Tema oscuro" Margin="0,10,0,0"
                               Click="ThemeSwitch_Click"/>
              <ui:ToggleSwitch x:Name="PinSwitch" Content="Siempre encima" IsChecked="True"
                               Margin="0,6,0,0" Click="Pin_Click"/>
            </StackPanel>
          </Border>

          <!-- Navegacion -->
          <StackPanel DockPanel.Dock="Top" Margin="0,6,0,0">
            <RadioButton x:Name="NavCapturas" Style="{StaticResource NavItem}" GroupName="nav"
                         IsChecked="True" Click="Nav_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Camera24" FontSize="16"/>
                <TextBlock Text="Capturas" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavArbol" Style="{StaticResource NavItem}" GroupName="nav" Click="Nav_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="TextBulletListTree24" FontSize="16"/>
                <TextBlock Text="Árbol de elementos" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavGrabar" Style="{StaticResource NavItem}" GroupName="nav" Click="Nav_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Record24" FontSize="16"/>
                <TextBlock Text="Grabar acciones" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavConfig" Style="{StaticResource NavItem}" GroupName="nav" Click="Nav_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Settings24" FontSize="16"/>
                <TextBlock Text="Configuración" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="NavAcerca" Style="{StaticResource NavItem}" GroupName="nav" Click="Nav_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" FontSize="16"/>
                <TextBlock Text="Acerca de" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <Grid/>
        </DockPanel>
      </Border>

      <!-- ===== Contenido ===== -->
      <Grid Grid.Column="1" Margin="18,10,18,16">

        <!-- Vista Capturas -->
        <Grid x:Name="CapturePanel">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <ui:InfoBar x:Name="EstadoBar" Grid.Row="0" IsOpen="True" IsClosable="False"
                      Severity="Informational" Title="Detenido"
                      Message="Presiona F8 (o el boton) para iniciar la captura global."/>

          <WrapPanel Grid.Row="1" Margin="0,12,0,12">
            <ui:Button x:Name="BtnToggle" Appearance="Primary" Margin="0,0,8,8"
                       Content="Iniciar captura (F8)" Click="Toggle_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Play24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Capturar en 3s" Click="Capture3s_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Timer24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Copiar locator" Click="CopyLoc_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Copiar Java" Click="CopyJava_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Copiar todo" Click="CopyAll_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Limpiar" Click="Clear_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="12" Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CAPTURAS RECIENTES" FontSize="10"
                           FontWeight="SemiBold" Margin="8,6,0,6"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ListBox x:Name="LstHistorial" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         FontFamily="{StaticResource Mono}" FontSize="12"
                         SelectionChanged="Hist_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding UiAutomation.ControlType, Converter={StaticResource TypeIcon}}"
                                       FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource AccentBlue}"/>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>

            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="DETALLE DEL ELEMENTO SELECCIONADO" FontSize="10"
                             FontWeight="SemiBold" Margin="14,10,0,0"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                  <TextBox x:Name="TxtProps" Style="{StaticResource MonoBox}"/>
                </DockPanel>
              </Border>
              <Border Grid.Row="1" CornerRadius="12" Margin="0,12,0,0" Padding="14,10"
                      Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel>
                  <TextBlock Text="LOCATOR RECOMENDADO" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                  <TextBox x:Name="TxtLocator" IsReadOnly="True" Background="Transparent"
                           BorderThickness="0" FontFamily="{StaticResource Mono}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- Vista Arbol -->
        <Grid x:Name="TreePanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <ui:Button Grid.Row="0" HorizontalAlignment="Left" Margin="0,4,0,12"
                     Content="Cargar árbol (ventana bajo cursor, 3s)" Click="LoadTree_Click">
            <ui:Button.Icon><ui:SymbolIcon Symbol="TextBulletListTree24"/></ui:Button.Icon>
          </ui:Button>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="400"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="12" Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        FontFamily="{StaticResource Mono}" FontSize="12"
                        SelectedItemChanged="Tree_SelectedItemChanged"/>
            </Border>
            <Border Grid.Column="2" CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <TextBox x:Name="TxtTreeProps" Style="{StaticResource MonoBox}"/>
            </Border>
          </Grid>
        </Grid>

        <!-- Vista Grabar acciones -->
        <Grid x:Name="RecordPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <ui:InfoBar x:Name="RecordBar" Grid.Row="0" IsOpen="True" IsClosable="False"
                      Severity="Informational" Title="Grabador de acciones"
                      Message="Pulsa Grabar y opera la app: los clicks y lo que escribas se convierten en pasos y en un script Winium."/>

          <WrapPanel Grid.Row="1" Margin="0,12,0,12">
            <ui:Button x:Name="BtnRecord" Appearance="Primary" Margin="0,0,8,8"
                       Content="Grabar" Click="Record_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Record24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Generar script" Click="GenScript_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Code24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Copiar script" Click="CopyScript_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Copy24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Exportar .java" Click="ExportScript_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Save24"/></ui:Button.Icon>
            </ui:Button>
            <ui:Button Margin="0,0,8,8" Content="Limpiar pasos" Click="ClearSteps_Click">
              <ui:Button.Icon><ui:SymbolIcon Symbol="Delete24"/></ui:Button.Icon>
            </ui:Button>
          </WrapPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="360"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="12" Padding="6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="PASOS GRABADOS" FontSize="10" FontWeight="SemiBold"
                           Margin="8,6,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ListBox x:Name="LstSteps" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         FontFamily="{StaticResource Mono}" FontSize="12"
                         MouseDoubleClick="Steps_DoubleClick"
                         ToolTip="Doble clic en un paso para elegir otro locator">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding Object.UiAutomation.ControlType, Converter={StaticResource TypeIcon}}"
                                       FontSize="15" Margin="0,0,8,0" Foreground="{StaticResource AccentBlue}"/>
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SCRIPT GENERADO (Winium / Java)" FontSize="10"
                           FontWeight="SemiBold" Margin="14,10,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBox x:Name="TxtScript" Style="{StaticResource MonoBox}"/>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- Vista Configuracion -->
        <StackPanel x:Name="ConfigPanel" Visibility="Collapsed" MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Configuración" FontSize="20" FontWeight="Bold" Margin="0,4,0,12"/>
          <Border CornerRadius="12" Padding="16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
              <TextBlock Text="Apariencia" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ui:ToggleSwitch x:Name="ThemeSwitch2" Content="Tema oscuro (Docks)" Click="ThemeSwitch_Click"/>
              <TextBlock Text="Alterna entre el tema Claro (Fluent/Windows 11) y Oscuro (Docks)."
                         FontSize="11" Margin="0,6,0,0"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Vista Acerca de -->
        <StackPanel x:Name="AboutPanel" Visibility="Collapsed" MaxWidth="620" HorizontalAlignment="Left">
          <TextBlock Text="Acerca de" FontSize="20" FontWeight="Bold" Margin="0,4,0,12"/>
          <Border CornerRadius="12" Padding="18" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel>
              <TextBlock Text="MoreWater Object Spy v0.5.1" FontSize="16" FontWeight="Bold"/>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="Inspector de objetos de UI para QA Automation. Captura el objeto en el instante del clic (UIA / MSAA / Win32) y genera locators para Winium, rankeados por estabilidad y unicidad."/>
              <TextBlock Margin="0,10,0,0" FontSize="12"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                         Text="Software de uso libre bajo licencia MIT · by MazahuaAlan"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <ui:HyperlinkButton Content="📄 Documentación" Margin="0,0,8,0"
                                    NavigateUri="https://mazahuaalan.github.io/MoreWaterObjectSpy-docs/"/>
                <ui:HyperlinkButton Content="🔗 Repositorio en GitHub"
                                    NavigateUri="https://github.com/MazahuaAlan/MoreWaterObjectSpy"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
