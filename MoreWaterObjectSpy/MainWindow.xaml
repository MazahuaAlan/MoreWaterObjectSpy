<Window x:Class="MoreWaterObjectSpy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MoreWater Object Spy" Height="700" Width="1080"
        MinWidth="920" MinHeight="580"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="Manual" Left="60" Top="50"
        Topmost="True" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        FontFamily="Segoe UI" Foreground="{StaticResource TextLight}">

  <Border CornerRadius="14" Margin="6">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BgTopColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BgBottomColor}" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ============ Barra superior ============ -->
      <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid Margin="16,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="11" Height="11" Fill="{StaticResource AccentRed}" Margin="0,0,7,0"/>
            <TextBlock Text="MoreWater Object Spy" FontWeight="SemiBold" FontSize="13"
                       VerticalAlignment="Center" Foreground="{StaticResource TextLight}"/>
            <TextBlock Text="v0.4.1" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMuted}"/>
          </StackPanel>

          <!-- Buscador (visual) -->
          <Border Grid.Column="1" Background="{StaticResource Field}" CornerRadius="9"
                  Height="28" Width="300" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                         Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
              <TextBlock Text="Buscar en el historial…" Margin="8,0,0,0" FontSize="12"
                         Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnPin" Style="{StaticResource WinBtn}" Content="&#xE718;"
                    Foreground="{StaticResource AccentRed}" Click="BtnPin_Click" ToolTip="Siempre visible"/>
            <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="&#xE921;" Click="BtnMin_Click"/>
            <Button x:Name="BtnClose" Style="{StaticResource WinBtn}" Content="&#xE8BB;" Click="BtnClose_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============ Cuerpo ============ -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="64"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" CornerRadius="0,0,0,14">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
              <ToggleButton x:Name="NavCaptura" Style="{StaticResource NavBtn}" Content="&#xEDA4;"
                            IsChecked="True" Click="Nav_Click" ToolTip="Captura"/>
              <ToggleButton x:Name="NavArbol" Style="{StaticResource NavBtn}" Content="&#xE8FD;"
                            Click="Nav_Click" ToolTip="Árbol de objetos"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
              <Button x:Name="BtnExport2" Style="{StaticResource WinBtn}" Content="&#xE74E;"
                      FontSize="16" Width="46" Height="46" Click="Export_Click" ToolTip="Exportar JSON"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1" Margin="18,8,18,16">

          <!-- ===== Vista Captura ===== -->
          <Grid x:Name="CapturePanel">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="LblEstado" Grid.Row="0" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextLight}" Margin="2,4,0,10"
                       Text="Detenido — presiona F8 para iniciar la captura global"/>

            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
              <Button x:Name="BtnToggle" Style="{StaticResource BtnRed}" Margin="0,0,8,8"
                      Content="▶  Iniciar captura (F8)" Click="Toggle_Click"/>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,8" Content="🎯  Capturar en 3s" Click="Capture3s_Click"/>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,8" Content="Copiar locator" Click="CopyLoc_Click"/>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,8" Content="Copiar Java" Click="CopyJava_Click"/>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,8" Content="Copiar todo" Click="CopyAll_Click"/>
              <Button Style="{StaticResource Btn}" Margin="0,0,8,8" Content="Limpiar" Click="Clear_Click"/>
            </WrapPanel>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="12" Padding="6">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="HISTORIAL DE CAPTURAS" FontSize="10"
                             FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="8,6,0,6"/>
                  <ListBox x:Name="LstHistorial" Style="{StaticResource Hist}"
                           ItemContainerStyle="{StaticResource HistItem}"
                           SelectionChanged="Hist_SelectionChanged"/>
                </DockPanel>
              </Border>

              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource Field}" CornerRadius="12" ClipToBounds="True">
                  <TextBox x:Name="TxtProps" Style="{StaticResource MonoBox}"/>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12" Margin="0,12,0,0" Padding="14,10">
                  <StackPanel>
                    <TextBlock Text="LOCATOR RECOMENDADO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtLocator" IsReadOnly="True" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource TextLight}"
                             FontFamily="{StaticResource Mono}" FontSize="14" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </Grid>

          <!-- ===== Vista Árbol ===== -->
          <Grid x:Name="TreePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Style="{StaticResource BtnBlue}" HorizontalAlignment="Left"
                    Margin="0,4,0,12" Content="🌳  Cargar árbol (ventana bajo cursor, 3s)" Click="LoadTree_Click"/>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="12" Padding="6">
                <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged"/>
              </Border>
              <Border Grid.Column="2" Background="{StaticResource Field}" CornerRadius="12" ClipToBounds="True">
                <TextBox x:Name="TxtTreeProps" Style="{StaticResource MonoBox}"/>
              </Border>
            </Grid>
          </Grid>

        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
