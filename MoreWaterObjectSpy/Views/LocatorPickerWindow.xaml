<ui:FluentWindow x:Class="MoreWaterObjectSpy.Views.LocatorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Elegir locator" Height="440" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Elegir locator"/>

    <TextBlock x:Name="LblObjeto" Grid.Row="1" Margin="18,4,18,10" FontSize="13" FontWeight="SemiBold"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

    <Border Grid.Row="2" Margin="18,0,18,0" CornerRadius="10"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <ListBox x:Name="LstCand" Margin="4" Background="Transparent" BorderThickness="0"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="6,4">
              <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Locator}" FontFamily="Cascadia Code, Consolas"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,16">
      <ui:Button Content="Usar seleccionado" Appearance="Primary" Margin="0,0,8,0" Click="Ok_Click"/>
      <ui:Button Content="Cancelar" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
