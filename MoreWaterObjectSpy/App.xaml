<Application x:Class="MoreWaterObjectSpy.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <!-- ================= Paleta Docks ================= -->
    <Color x:Key="BgTopColor">#374862</Color>
    <Color x:Key="BgBottomColor">#2B3A4E</Color>
    <SolidColorBrush x:Key="Sidebar"  Color="#243141"/>
    <SolidColorBrush x:Key="Surface"  Color="#313F55"/>
    <SolidColorBrush x:Key="Card"     Color="#3E4E68"/>
    <SolidColorBrush x:Key="Field"    Color="#26313F"/>
    <SolidColorBrush x:Key="AccentRed"  Color="#EF4B4C"/>
    <SolidColorBrush x:Key="AccentBlue" Color="#3D619B"/>
    <SolidColorBrush x:Key="AccentBlueHi" Color="#4C7DCB"/>
    <SolidColorBrush x:Key="TextLight" Color="#E9E9EB"/>
    <SolidColorBrush x:Key="TextMuted" Color="#93A1B6"/>
    <SolidColorBrush x:Key="Line"      Color="#3B4A61"/>

    <FontFamily x:Key="Mono">Cascadia Code, Consolas, monospace</FontFamily>

    <!-- ================= Botones de ventana (min / cerrar) ================= -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3A4A60"/>
                <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Iconos del sidebar (ToggleButton) ================= -->
    <Style x:Key="NavBtn" TargetType="ToggleButton">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                      Background="{StaticResource AccentRed}" Opacity="0"/>
              <Border x:Name="b" Background="Transparent" CornerRadius="12" Margin="6,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2C3B4E"/>
                <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2C3B4E"/>
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= Botones de accion ================= -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnRed" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource AccentRed}"/>
    </Style>
    <Style x:Key="BtnBlue" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
    </Style>

    <!-- ================= TextBox monoespaciado (propiedades) ================= -->
    <Style x:Key="MonoBox" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- ================= ListBox (historial) ================= -->
    <Style x:Key="Hist" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="HistItem" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#2C3B4E"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBlue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= TreeView oscuro ================= -->
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
      <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
  </Application.Resources>
</Application>
