<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- UI en WPF (rama rediseno-wpf). UseWPF habilita ademas UIAutomationClient/UIAutomationTypes sin NuGet -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>MoreWater Object Spy</AssemblyTitle>
    <Version>0.5.4</Version>
    <Authors>MazahuaAlan</Authors>
    <Company>MoreWater QA</Company>
    <Product>MoreWater Object Spy</Product>
    <Copyright>© MazahuaAlan</Copyright>
    <RepositoryUrl>https://github.com/MazahuaAlan</RepositoryUrl>
    <!-- Icono del ejecutable: Explorador, barra de tareas y Alt+Tab.
         Se regenera con docs\tools\generar-icono.ps1 (7 resoluciones, 16..256). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- Tambien como recurso, para poder fijarlo como Icon de la ventana. -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
