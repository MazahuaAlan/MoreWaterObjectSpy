<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF habilita las referencias UIAutomationClient/UIAutomationTypes (System.Windows.Automation) sin NuGet -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>MoreWater Object Spy</AssemblyTitle>
    <Version>0.2.0</Version>
    <Authors>MazahuaAlan</Authors>
    <Company>MoreWater QA</Company>
    <Product>MoreWater Object Spy</Product>
    <Copyright>© MazahuaAlan</Copyright>
    <RepositoryUrl>https://github.com/MazahuaAlan</RepositoryUrl>
  </PropertyGroup>

</Project>
